{
  "name": "focusiq",
  "version": "0.1.0",
  "private": true,
  "description": "FocusiQ – behavioural assessment platform for Walter Geering",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p app/tsconfig.json",
    "test": "vitest run",
    "dev": "vite --config app/vite.config.ts",
    "build:app": "vite build --config app/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  }
}
